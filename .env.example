ASTERISK_ARI_SCHEME=http
ASTERISK_ARI_HOST=asterisk.example.com
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USERNAME=asterisk
ASTERISK_ARI_PASSWORD=change-me

VOICE_LOGGER_IP=asterisk.example.com
VOICE_LOGGER_PORT=8085

AST_DB_HOST=asterisk.example.com
AST_DB_PORT=3306
AST_DB_DATABASE=asterisk
AST_DB_USERNAME=dashboard
AST_DB_PASSWORD=change-me

SERVER_IP=asterisk.example.com
SERVER_PORT=8001

REDIS_ADDRESS=asterisk.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- record_calls.dart (bin/record_calls.dart) ---
PHONE_ENDPOINT=PJSIP/3636@mytrunk

RECORDER_HTTP_HOST=asterisk.example.com
RECORDER_HTTP_PORT=8085
RECORDER_RTP_HOST=asterisk.example.com
RECORDER_ALLOC_PATH=/
# RECORDER_STOP_PATH=/stop
RECORDER_FORMAT=alaw

RECORDINGS_DIR=./recordings_out

# --- enrich_from_homer.dart ---
HOMER_PG_HOST=127.0.0.1
HOMER_PG_PORT=5432
HOMER_PG_DB=homer_data
HOMER_PG_USER=root
HOMER_PG_PASS=change-me
POLL_INTERVAL_SECS=5
LOOKBACK_MINUTES=60
